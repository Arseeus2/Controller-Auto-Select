<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.0.0.0</Version>
    <AssemblyName>ControllerAutoSelect</AssemblyName>
    <Author>Local development</Author>
    <Name>Controller Auto Select</Name>
    <Punchline>Use your preferred controller when it connects.</Punchline>
    <Description>Choose a connected controller, and FFXIV switches to that controller after it connects in case of a disconnect. No more going to the System Settings every single time!</Description>
    <Tags>controller;gamepad</Tags>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CanUnloadAsync>true</CanUnloadAsync>
    <Use_Dalamud_Lumina>false</Use_Dalamud_Lumina>
    <Use_Dalamud_Lumina_Excel>false</Use_Dalamud_Lumina_Excel>
    <Use_Dalamud_Serilog>false</Use_Dalamud_Serilog>
    <Use_Dalamud_MSObjectPool>false</Use_Dalamud_MSObjectPool>
  </PropertyGroup>
</Project>
